# Provedor LLM (valores: openai, ollama, lmstudio, openrouter, opencode_zen, google_gemini_api, google_gemini_oauth)
LLM_PROVIDER=openai

# Configurações OpenAI (padrão)
OPENAI_API_KEY=sua-chave-aqui
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Configurações Ollama (Local)
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=ollama

# Configurações LM Studio (Local)
LMSTUDIO_MODEL=local-model
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_API_KEY=lm-studio

# Configurações OpenRouter (SaaS)
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=sua-chave-aqui

# Configurações Opencode Zen (SaaS)
OPENCODE_ZEN_MODEL=qwen-coder-plus
OPENCODE_ZEN_BASE_URL=
OPENCODE_ZEN_API_KEY=sua-chave-aqui

# Configurações Google Gemini API
GEMINI_MODEL=gemini-1.5-flash
GOOGLE_API_KEY=sua-chave-aqui

# Configurações Google Gemini OAuth (não requer API_KEY, usa autenticação OAuth)
# GEMINI_MODEL=gemini-1.5-flash

# Configurações gerais
FINOPS_TEMPERATURE=0.2
FINOPS_MAX_TOKENS=1200
